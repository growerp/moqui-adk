<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Configuration" menu-image="fa fa-cog" menu-image-type="icon"
        default-menu-index="3" require-authentication="true">

    <transition name="updateConfig">
        <service-call name="AdkServices.update#AgentConfig"/>
        <default-response url="."/>
    </transition>

    <actions>
        <set field="configValue" from="ec.entity.find('moqui.adk.AdkAgentConfig').condition('enabled', 'Y').one()"/>
    </actions>

    <widgets>
        <container-row>
            <row-col lg="8" md="12">
                <container-box>
                    <box-header title="ADK Server Configuration"/>
                    <box-body>
                        <label text="Point this to your standalone Google ADK server." type="p"/>
                        <form-single name="AdkConfigForm" transition="updateConfig">
                            <field name="adkServerUrl">
                                <default-field title="ADK Server URL">
                                    <text-line size="60" default-value="${configValue?.adkServerUrl ?: 'http://localhost:8090'}"/>
                                </default-field>
                            </field>
                            <field name="description">
                                <default-field title="Description">
                                    <text-line size="60" default-value="${configValue?.description ?: 'ADK Server'}"/>
                                </default-field>
                            </field>
                            <field name="submitButton">
                                <default-field title="">
                                    <submit text="Save Configuration"/>
                                </default-field>
                            </field>
                        </form-single>
                    </box-body>
                </container-box>
            </row-col>
        </container-row>
    </widgets>
</screen>
