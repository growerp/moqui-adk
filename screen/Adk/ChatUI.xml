<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Chat UI" menu-image="fa fa-comments" menu-image-type="icon"
        default-menu-index="2" require-authentication="true">

    <transition name="createSession" method="post">
        <actions><script><![CDATA[
            import org.moqui.adk.AdkSessionHolder
            String sid = UUID.randomUUID().toString()
            AdkSessionHolder.sessions[sid] = []
            ec.web.sendJsonResponse([sessionId: sid])
        ]]></script></actions>
        <default-response type="none"/>
    </transition>
    <transition name="runAgent" method="post">
        <actions><script><![CDATA[
            import groovy.json.JsonOutput
            import groovy.json.JsonSlurper
            import java.net.http.HttpClient
            import java.net.http.HttpRequest
            import java.net.http.HttpResponse

            String sid = context.sessionId ?: ""
            String msg = context.message ?: ""
            if (!sid || !msg) { ec.web.sendJsonResponse([errorMessage: "sessionId and message required"]); return }

            boolean wasDisabled = ec.artifactExecution.disableAuthz()
            def cfg
            try { cfg = ec.entity.find("moqui.adk.AdkAgentConfig").condition("enabled", "Y").one() }
            finally { if (!wasDisabled) ec.artifactExecution.enableAuthz() }

            String apiKey  = cfg?.apiKey ?: System.getenv("GOOGLE_API_KEY") ?: System.getenv("GOOGLE_GENAI_API_KEY") ?: System.getenv("GEMINI_API_KEY") ?: ""
            String model   = cfg?.modelName ?: "gemini-2.0-flash"
            String sysInstr = cfg?.instruction ?: ""
            if (!apiKey) { ec.web.sendJsonResponse([errorMessage: "No API key configured — go to ADK → Configuration"]); return }

            def history = org.moqui.adk.AdkSessionHolder.sessions.computeIfAbsent(sid, { [] })
            history << [role: "user", parts: [[text: msg]]]
            def bodyMap = [contents: history]
            if (sysInstr) bodyMap['system_instruction'] = [parts: [[text: sysInstr]]]

            def client  = HttpClient.newHttpClient()
            def req = HttpRequest.newBuilder()
                .uri(URI.create("https://generativelanguage.googleapis.com/v1beta/models/${model}:generateContent?key=${apiKey}"))
                .header("Content-Type", "application/json")
                .POST(HttpRequest.BodyPublishers.ofString(JsonOutput.toJson(bodyMap)))
                .build()
            def httpResp = client.send(req, HttpResponse.BodyHandlers.ofString())
            def parsed   = new JsonSlurper().parseText(httpResp.body())

            String response = parsed?.candidates?.getAt(0)?.content?.parts?.getAt(0)?.text ?: ""
            if (!response && parsed?.error) response = "[Gemini error: ${parsed.error.message}]"
            if (response) history << [role: "model", parts: [[text: response]]]

            ec.web.sendJsonResponse([response: response])
        ]]></script></actions>
        <default-response type="none"/>
    </transition>

    <widgets>
        <render-mode>
            <text type="vuet"><![CDATA[
                <style>
                #adk-panel{display:flex;flex-direction:column;height:calc(100vh - 200px);min-height:420px;margin:0;border-radius:6px;overflow:hidden;box-shadow:0 1px 4px rgba(0,0,0,.15)}
                #adk-head{background:#3c8dbc;color:#fff;padding:10px 15px;display:flex;align-items:center;justify-content:space-between;flex-shrink:0}
                #adk-head h4{margin:0;font-size:15px;font-weight:600}
                #adk-st{font-size:12px;opacity:.85;background:rgba(255,255,255,.2);padding:2px 8px;border-radius:10px}
                #adk-msgs{flex:1;overflow-y:auto;padding:16px;background:#f4f6f8;display:flex;flex-direction:column;gap:10px}
                .adk-row-u{display:flex;justify-content:flex-end}
                .adk-row-a{display:flex;justify-content:flex-start;align-items:flex-start;gap:8px}
                .adk-avatar{width:32px;height:32px;border-radius:50%;background:#3c8dbc;color:#fff;display:flex;align-items:center;justify-content:center;font-size:13px;flex-shrink:0}
                .adk-bubble{max-width:72%;padding:10px 14px;border-radius:18px;word-wrap:break-word;line-height:1.55;font-size:14px}
                .adk-bubble-u{background:#3c8dbc;color:#fff;border-bottom-right-radius:4px}
                .adk-bubble-a{background:#fff;color:#333;border:1px solid #dde3e8;border-bottom-left-radius:4px;white-space:pre-wrap}
                .adk-bubble-e{background:#fdf2f2;color:#c0392b;border:1px solid #f5c6cb;border-radius:8px;max-width:100%;font-size:13px}
                #adk-foot{padding:12px 15px;background:#fff;border-top:1px solid #e0e0e0;flex-shrink:0}
                </style>

                <div id="adk-panel">
                    <div id="adk-head">
                        <h4><i class="fa fa-comments" style="margin-right:7px"></i>ADK Agent</h4>
                        <span id="adk-st">Connecting…</span>
                    </div>
                    <div id="adk-msgs"></div>
                    <div id="adk-foot">
                        <div class="input-group">
                            <input id="adk-in" type="text" class="form-control"
                                   placeholder="Type a message and press Enter…"
                                   onkeydown="if(event.key==='Enter'&amp;&amp;!event.shiftKey){event.preventDefault();adkSend();}"/>
                            <span class="input-group-btn">
                                <button id="adk-btn" class="btn btn-primary" onclick="adkSend()">
                                    <i class="fa fa-paper-plane"></i> Send
                                </button>
                            </span>
                        </div>
                    </div>
                </div>
                <script>
                (function(){
                    var basePath = document.getElementById('confBasePath');
                    var base = (basePath ? basePath.value : '') + '/adk/ChatUI';
                    var CREATE_URL = base + '/createSession';
                    var RUN_URL    = base + '/runAgent';
                    var SID = null, BUSY = false;
                    function headers() {
                        var t = document.getElementById('confMoquiSessionToken');
                        return {'Content-Type':'application/json','Accept':'application/json','X-CSRF-Token': t ? t.value : ''};
                    }

                    function st(m){
                        var el = document.getElementById('adk-st');
                        if(el) el.textContent = m;
                    }
                    function addMsg(type, txt){
                        var c = document.getElementById('adk-msgs');
                        var row = document.createElement('div');
                        if(type === 'u'){
                            row.className = 'adk-row-u';
                            var b = document.createElement('div');
                            b.className = 'adk-bubble adk-bubble-u';
                            b.textContent = txt;
                            row.appendChild(b);
                        } else if(type === 'e'){
                            row.className = 'adk-row-a';
                            var b = document.createElement('div');
                            b.className = 'adk-bubble adk-bubble-e';
                            b.textContent = txt;
                            row.appendChild(b);
                        } else {
                            row.className = 'adk-row-a';
                            var av = document.createElement('div');
                            av.className = 'adk-avatar';
                            av.innerHTML = '<i class="fa fa-robot"></i>';
                            var b = document.createElement('div');
                            b.className = 'adk-bubble adk-bubble-a';
                            b.textContent = txt;
                            row.appendChild(av);
                            row.appendChild(b);
                        }
                        c.appendChild(row);
                        c.scrollTop = c.scrollHeight;
                        return b;
                    }

                    fetch(CREATE_URL, {method:'POST', headers:headers(), body:'{}'})
                    .then(function(r){ return r.json(); })
                    .then(function(d){
                        if(d.sessionId){ SID = d.sessionId; st('Ready'); }
                        else { st('Config error — set API key in Configuration'); addMsg('e', d.errorMessage || 'Failed to create session'); }
                    })
                    .catch(function(e){ st('Cannot connect'); addMsg('e', 'Error: ' + e); });

                    window.adkSend = function(){
                        if(BUSY || !SID) return;
                        var inp = document.getElementById('adk-in'), txt = inp.value.trim();
                        if(!txt) return;
                        inp.value = ''; BUSY = true; document.getElementById('adk-btn').disabled = true;
                        addMsg('u', txt);
                        var thinking = addMsg('a', '…');
                        st('Thinking…');
                        fetch(RUN_URL, {method:'POST', headers:headers(),
                            body: JSON.stringify({sessionId: SID, message: txt})})
                        .then(function(r){ return r.json(); })
                        .then(function(d){
                            if(d.response !== undefined){ thinking.textContent = d.response || '(no response)'; st('Ready'); }
                            else { thinking.textContent = d.errorMessage || 'Unknown error'; thinking.className = 'adk-bubble adk-bubble-e'; st('Error'); }
                        })
                        .catch(function(e){ thinking.textContent = 'Error: ' + e; thinking.className = 'adk-bubble adk-bubble-e'; st('Error'); })
                        .finally(function(){ BUSY = false; document.getElementById('adk-btn').disabled = false; });
                    };
                })();
                </script>
            ]]></text>
        </render-mode>
    </widgets>
</screen>
