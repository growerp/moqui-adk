<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-index="1" menu-image="fa fa-dashboard" menu-image-type="icon"
        default-menu-title="Dashboard">

    <actions>
        <script><![CDATA[
            configValue = ec.entity.find("moqui.adk.AdkAgentConfig").condition("enabled", "Y").one()
            adkServerUrl = configValue?.adkServerUrl ?: "http://localhost:8090"
            adkReady = false
            try {
                def conn = new URL("${adkServerUrl}/").openConnection()
                conn.connectTimeout = 1000
                conn.instanceFollowRedirects = false
                conn.connect()
                adkReady = conn.responseCode < 500
            } catch (Exception e) { adkReady = false }
        ]]></script>
    </actions>

    <widgets>
        <container-row>
            <row-col lg="6" md="12">
                <container-box>
                    <box-header title="ADK Server Status"/>
                    <box-body>
                        <label text="Server URL: ${adkServerUrl}" type="p"/>
                        <label text="Status: ${adkReady ? 'Running' : 'Not reachable'}" type="p"
                               style="${adkReady ? 'color:green;font-weight:bold' : 'color:red'}"/>
                    </box-body>
                    <box-toolbar>
                        <link url="../ChatUI" text="Open Chat UI" btn-type="primary"/>
                        <link url="../Configuration" text="Configure" btn-type="default"/>
                    </box-toolbar>
                </container-box>
            </row-col>
            <row-col lg="6" md="12">
                <container-box>
                    <box-header title="${adkReady ? 'Ready' : 'Quick Start'}"/>
                    <box-body>
                        <section name="ReadySection" condition="adkReady">
                            <widgets>
                                <label text="ADK server is running at ${adkServerUrl}" type="p" style="color:green"/>
                                <label text="Use the Chat UI tab to interact with your agent." type="p"/>
                            </widgets>
                            <fail-widgets>
                                <label text="Start your ADK server, then open the Chat UI." type="p"/>
                                <label text="From moqui/:" type="p"/>
                                <label text="GOOGLE_GENAI_API_KEY=... ./gradlew :runtime:component:moqui-adk:adkServer" type="p" style="font-family:monospace;font-size:0.85em"/>
                            </fail-widgets>
                        </section>
                    </box-body>
                </container-box>
            </row-col>
        </container-row>
    </widgets>
</screen>
