<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-include="false" require-authentication="true">

    <parameter name="toUserId" required="true"/>

    <!-- Send a message -->
    <transition name="sendMessage" method="post">
        <actions><script><![CDATA[
            import java.sql.Timestamp
            String toUid = context.toUserId ?: ""
            String msg   = context.message   ?: ""
            if (!toUid || !msg) { ec.web.sendJsonResponse([error: "missing params"]); return }

            boolean wasDisabled = ec.artifactExecution.disableAuthz()
            try {
                String roomId = [ec.user.userId, toUid].sort().join('|')
                def val = ec.entity.makeValue("moqui.adk.AdkChatMessage")
                    .setSequencedIdPrimary()
                    .set("chatRoomId",  roomId)
                    .set("fromUserId",  ec.user.userId)
                    .set("message",     msg)
                    .set("sentDate",    new Timestamp(System.currentTimeMillis()))
                    .create()
                ec.web.sendJsonResponse([id: val.chatMessageId, sentDate: val.sentDate.time])
            } finally {
                if (!wasDisabled) ec.artifactExecution.enableAuthz()
            }
        ]]></script></actions>
        <default-response type="none"/>
    </transition>

    <!-- Poll for new messages -->
    <transition name="fetchMessages" method="post">
        <actions><script><![CDATA[
            import java.sql.Timestamp
            import org.moqui.entity.EntityCondition
            String toUid = context.toUserId ?: ""
            if (!toUid) { ec.web.sendJsonResponse([messages: []]); return }

            boolean wasDisabled = ec.artifactExecution.disableAuthz()
            try {
                String roomId = [ec.user.userId, toUid].sort().join('|')
                long sinceMs  = context.since ? Long.parseLong(context.since.toString()) : 0

                def find = ec.entity.find("moqui.adk.AdkChatMessage")
                    .condition("chatRoomId", roomId)
                    .orderBy("sentDate")
                if (sinceMs > 0)
                    find.condition("sentDate", EntityCondition.ComparisonOperator.GREATER_THAN,
                                   new Timestamp(sinceMs))

                def msgList = find.list().collect { m ->
                    [id: m.chatMessageId, from: m.fromUserId,
                     message: m.message, time: m.sentDate.time]
                }
                ec.web.sendJsonResponse([messages: msgList])
            } finally {
                if (!wasDisabled) ec.artifactExecution.enableAuthz()
            }
        ]]></script></actions>
        <default-response type="none"/>
    </transition>

    <actions>
        <script><![CDATA[
            boolean wasDisabled = ec.artifactExecution.disableAuthz()
            try {
                def toUser = ec.entity.find("moqui.security.UserAccount")
                    .condition("userId", toUserId).one()
                toUserName = toUser ? (toUser.firstName ? "${toUser.firstName} ${toUser.lastName ?: ''}".trim() : toUser.username) : toUserId
                toUserInitial = toUserName ? toUserName[0].toUpperCase() : "?"
            } finally {
                if (!wasDisabled) ec.artifactExecution.enableAuthz()
            }
        ]]></script>
    </actions>

    <widgets>
        <render-mode>
            <text type="vuet"><![CDATA[
                <style>
                #cr-panel{display:flex;flex-direction:column;height:calc(100vh - 200px);min-height:420px;border-radius:6px;overflow:hidden;box-shadow:0 1px 4px rgba(0,0,0,.15)}
                #cr-head{background:#3c8dbc;color:#fff;padding:12px 16px;display:flex;align-items:center;gap:12px;flex-shrink:0}
                .cr-av{width:38px;height:38px;border-radius:50%;background:rgba(255,255,255,.25);display:flex;align-items:center;justify-content:center;font-weight:700;font-size:15px;flex-shrink:0}
                #cr-head-info h4{margin:0;font-size:15px;font-weight:600}
                #cr-head-info small{opacity:.8;font-size:12px}
                #cr-st{margin-left:auto;font-size:11px;background:rgba(255,255,255,.2);padding:2px 8px;border-radius:10px}
                #cr-msgs{flex:1;overflow-y:auto;padding:16px;background:#f4f6f8;display:flex;flex-direction:column;gap:10px}
                .cr-row-me{display:flex;justify-content:flex-end}
                .cr-row-them{display:flex;justify-content:flex-start;align-items:flex-end;gap:8px}
                .cr-mini-av{width:28px;height:28px;border-radius:50%;background:#3c8dbc;color:#fff;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;flex-shrink:0}
                .cr-bubble{max-width:68%;padding:9px 14px;border-radius:18px;word-wrap:break-word;line-height:1.5;font-size:14px;position:relative}
                .cr-bubble-me{background:#3c8dbc;color:#fff;border-bottom-right-radius:4px}
                .cr-bubble-them{background:#fff;color:#333;border:1px solid #dde3e8;border-bottom-left-radius:4px;white-space:pre-wrap}
                .cr-time{font-size:10px;opacity:.6;margin-top:3px;text-align:right}
                .cr-time-them{text-align:left}
                #cr-foot{padding:12px 15px;background:#fff;border-top:1px solid #e0e0e0;flex-shrink:0}
                #cr-empty{text-align:center;color:#aaa;margin-top:40px;font-size:14px}
                </style>

                <div id="cr-panel">
                    <div id="cr-head">
                        <div class="cr-av">${toUserInitial}</div>
                        <div id="cr-head-info">
                            <h4>${toUserName}</h4>
                            <small>Direct message</small>
                        </div>
                        <span id="cr-st">Loading…</span>
                    </div>
                    <div id="cr-msgs">
                        <div id="cr-empty"><i class="fa fa-comments fa-2x" style="display:block;margin-bottom:8px"></i>No messages yet. Say hello!</div>
                    </div>
                    <div id="cr-foot">
                        <div class="input-group">
                            <input id="cr-in" type="text" class="form-control"
                                   placeholder="Message ${toUserName}…"
                                   onkeydown="if(event.key==='Enter'&amp;&amp;!event.shiftKey){event.preventDefault();crSend();}"/>
                            <span class="input-group-btn">
                                <button id="cr-btn" class="btn btn-primary" onclick="crSend()">
                                    <i class="fa fa-paper-plane"></i> Send
                                </button>
                            </span>
                        </div>
                    </div>
                </div>

                <script>
                (function(){
                    var bp    = document.getElementById('confBasePath');
                    var base  = (bp ? bp.value : '') + '/adk/ChatRoom';
                    var SEND  = base + '/sendMessage';
                    var FETCH = base + '/fetchMessages';
                    var MY_ID = '${ec.user.userId}';
                    var TO_ID = '${toUserId}';
                    var TO_IN = '${toUserInitial}';
                    var lastSince = 0, polling = null;

                    function hdrs() {
                        var t = document.getElementById('confMoquiSessionToken');
                        return {'Content-Type':'application/json','Accept':'application/json','X-CSRF-Token': t ? t.value : ''};
                    }
                    function st(m){ var el = document.getElementById('cr-st'); if(el) el.textContent = m; }
                    function fmtTime(ms){
                        var d = new Date(ms);
                        return d.getHours().toString().padStart(2,'0') + ':' + d.getMinutes().toString().padStart(2,'0');
                    }

                    function addMsg(fromId, text, timeMs) {
                        var empty = document.getElementById('cr-empty');
                        if(empty) empty.remove();
                        var c = document.getElementById('cr-msgs');
                        var isMe = (fromId === MY_ID);
                        var row = document.createElement('div');
                        row.className = isMe ? 'cr-row-me' : 'cr-row-them';

                        if(!isMe) {
                            var av = document.createElement('div');
                            av.className = 'cr-mini-av';
                            av.textContent = TO_IN;
                            row.appendChild(av);
                        }

                        var wrap = document.createElement('div');
                        var bubble = document.createElement('div');
                        bubble.className = 'cr-bubble ' + (isMe ? 'cr-bubble-me' : 'cr-bubble-them');
                        bubble.textContent = text;
                        var time = document.createElement('div');
                        time.className = 'cr-time' + (isMe ? '' : ' cr-time-them');
                        time.textContent = fmtTime(timeMs);
                        wrap.appendChild(bubble);
                        wrap.appendChild(time);
                        row.appendChild(wrap);
                        c.appendChild(row);
                        c.scrollTop = c.scrollHeight;
                    }

                    function fetchMessages() {
                        fetch(FETCH, {method:'POST', headers:hdrs(),
                            body: JSON.stringify({toUserId: TO_ID, since: lastSince})})
                        .then(function(r){ return r.json(); })
                        .then(function(d){
                            if(d.messages && d.messages.length > 0) {
                                d.messages.forEach(function(m){
                                    addMsg(m.from, m.message, m.time);
                                    if(m.time > lastSince) lastSince = m.time;
                                });
                            }
                            st('Ready');
                        })
                        .catch(function(e){ st('Error'); console.error(e); });
                    }

                    window.crSend = function(){
                        var inp = document.getElementById('cr-in');
                        var txt = inp.value.trim();
                        if(!txt) return;
                        document.getElementById('cr-btn').disabled = true;
                        inp.value = '';
                        fetch(SEND, {method:'POST', headers:hdrs(),
                            body: JSON.stringify({toUserId: TO_ID, message: txt})})
                        .then(function(r){ return r.json(); })
                        .then(function(d){
                            if(d.id) { addMsg(MY_ID, txt, d.sentDate); if(d.sentDate > lastSince) lastSince = d.sentDate; }
                        })
                        .catch(function(e){ console.error(e); })
                        .finally(function(){ document.getElementById('cr-btn').disabled = false; });
                    };

                    // Initial load then poll every 3 s (skip when tab hidden)
                    fetchMessages();
                    polling = setInterval(function(){ if(!document.hidden) fetchMessages(); }, 3000);
                })();
                </script>
            ]]></text>
        </render-mode>
    </widgets>
</screen>
