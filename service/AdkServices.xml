<?xml version="1.0" encoding="UTF-8"?>
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-3.xsd">

    <service verb="update" noun="AgentConfig">
        <description>Save ADK agent configuration.</description>
        <in-parameters>
            <parameter name="agentName"   default-value="MoquiAgent"/>
            <parameter name="modelName"   default-value="gemini-2.0-flash"/>
            <parameter name="apiKey"      required="true"/>
            <parameter name="instruction"/>
            <parameter name="description"/>
        </in-parameters>
        <actions>
            <!-- Disable all currently enabled configs -->
            <entity-find entity-name="moqui.adk.AdkAgentConfig" list="enabledList">
                <econdition field-name="enabled" value="Y"/>
            </entity-find>
            <iterate list="enabledList" entry="cfg">
                <set field="cfg.enabled" value="N"/>
                <entity-update value-field="cfg"/>
            </iterate>

            <!-- Update existing or create new -->
            <entity-find entity-name="moqui.adk.AdkAgentConfig" list="existingList">
                <econdition field-name="agentName" from="agentName"/>
            </entity-find>
            <if condition="existingList">
                <set field="existing" from="existingList[0]"/>
                <set field="existing.modelName"   from="modelName"/>
                <set field="existing.apiKey"      from="apiKey"/>
                <set field="existing.instruction" from="instruction"/>
                <set field="existing.description" from="description"/>
                <set field="existing.enabled"     value="Y"/>
                <entity-update value-field="existing"/>
                <else>
                    <entity-make-value entity-name="moqui.adk.AdkAgentConfig" value-field="newCfg"/>
                    <set field="newCfg.agentName"   from="agentName   ?: 'MoquiAgent'"/>
                    <set field="newCfg.modelName"   from="modelName   ?: 'gemini-2.0-flash'"/>
                    <set field="newCfg.apiKey"      from="apiKey"/>
                    <set field="newCfg.instruction" from="instruction ?: 'You are a helpful assistant for the GrowERP ERP system.'"/>
                    <set field="newCfg.description" from="description ?: 'ADK Agent'"/>
                    <set field="newCfg.enabled"     value="Y"/>
                    <entity-sequenced-id-primary value-field="newCfg"/>
                    <entity-create value-field="newCfg"/>
                </else>
            </if>
        </actions>
    </service>

    <service verb="create" noun="Session" authenticate="true">
        <description>Create a new chat session for the current user.</description>
        <out-parameters>
            <parameter name="sessionId"/>
        </out-parameters>
        <actions>
            <script><![CDATA[
                sessionId = UUID.randomUUID().toString()
                org.moqui.adk.AdkSessionHolder.sessions[sessionId] = []
            ]]></script>
        </actions>
    </service>

    <service verb="run" noun="Agent" authenticate="true">
        <description>Send a message to the Gemini agent and return its reply.</description>
        <in-parameters>
            <parameter name="sessionId" required="true"/>
            <parameter name="message"   required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="response"/>
        </out-parameters>
        <actions>
            <entity-find entity-name="moqui.adk.AdkAgentConfig" list="cfgList">
                <econdition field-name="enabled" value="Y"/>
            </entity-find>
            <set field="cfg" from="cfgList ? cfgList[0] : null"/>

            <script><![CDATA[
                import org.moqui.util.RestClient

                String apiKey   = cfg?.apiKey ?: System.getenv("GOOGLE_API_KEY") ?:
                                  System.getenv("GOOGLE_GENAI_API_KEY") ?: System.getenv("GEMINI_API_KEY") ?: ""
                String model    = cfg?.modelName ?: "gemini-2.0-flash"
                String sysInstr = cfg?.instruction ?: ""

                if (!apiKey) { response = "[Error: no API key — set one in ADK → Configuration or env GOOGLE_API_KEY]"; return }

                def history = org.moqui.adk.AdkSessionHolder.sessions.computeIfAbsent(sessionId, { [] })
                history << [role: "user", parts: [[text: message]]]

                def bodyMap = [contents: history]
                if (sysInstr) bodyMap['system_instruction'] = [parts: [[text: sysInstr]]]

                RestClient rc = ec.service.rest().method(RestClient.POST)
                rc.uri().protocol("https").port(443)
                    .host("generativelanguage.googleapis.com")
                    .path("/v1beta/models/${model}:generateContent")
                    .parameter("key", apiKey).build()
                rc.addHeader("Content-Type", "application/json").addBodyParameters(bodyMap)
                RestClient.RestResponse resp = rc.call()
                def parsed = resp.jsonObject()

                response = parsed?.candidates?.getAt(0)?.content?.parts?.getAt(0)?.text ?: ""
                if (!response && parsed?.error) response = "[Gemini error: ${parsed.error.message}]"
                if (response) history << [role: "model", parts: [[text: response]]]
            ]]></script>
        </actions>
    </service>

</services>
