<?xml version="1.0" encoding="UTF-8"?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">

    <!-- ADK agent config (one active record; apiKey stored in plaintext — encrypt at rest via Moqui crypto if needed) -->
    <entity entity-name="AdkAgentConfig" package="moqui.adk" use="configuration">
        <field name="adkAgentConfigId" type="id" is-pk="true"/>
        <field name="agentName"   type="text-short"/>
        <field name="modelName"   type="text-short"/>
        <field name="apiKey"      type="text-medium"/>
        <field name="instruction" type="text-long"/>
        <field name="description" type="text-short"/>
        <field name="enabled"     type="text-indicator"/>
    </entity>

    <entity entity-name="AdkChatMessage" package="moqui.adk" use="transactional">
        <field name="chatMessageId" type="id"          is-pk="true"/>
        <field name="chatRoomId"    type="id-long"/>
        <field name="fromUserId"    type="id-long"/>
        <field name="message"       type="text-long"/>
        <field name="sentDate"      type="date-time"/>
        <index name="ADK_CM_ROOM" unique="false"><index-field name="chatRoomId"/><index-field name="sentDate"/></index>
    </entity>

</entities>
